FROM golang:1.21-alpine AS builder
WORKDIR /app
COPY server/go.mod server/go.sum ./
RUN go mod download
COPY server/ .
RUN go build -o /app/server ./cmd/main.go

FROM alpine:latest
RUN apk add --no-cache ca-certificates
WORKDIR /app
COPY --from=builder /app/server .
RUN mkdir -p /app/data/downloads
EXPOSE 8080
CMD ["./server"]
